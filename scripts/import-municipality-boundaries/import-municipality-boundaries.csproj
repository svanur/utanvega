<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Utanvega.Scripts.ImportMunicipalityBoundaries</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>
    <ItemGroup>
        <!-- Same versions as backend/backend.csproj — this tool parses/validates the exact
             GeoJSON shape Location.Boundary expects. -->
        <PackageReference Include="NetTopologySuite" Version="2.*" />
        <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.*" />
    </ItemGroup>
    <ItemGroup>
        <!-- #1751: reuse the MultiPolygon → Polygon reduction scripts/import-landsvaedi-regions
             extracted into its own file for xUnit coverage (#1764, backend.Tests/Services/
             MultiPolygonReducerTests.cs), instead of keeping a second, divergent copy of the same
             algorithm inlined in this script's Program.cs. -->
        <Compile Include="..\import-landsvaedi-regions\MultiPolygonReducer.cs" Link="MultiPolygonReducer.cs" />
    </ItemGroup>
</Project>
