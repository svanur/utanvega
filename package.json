{
  "private": true,
  "name": "hlaupaleidir",
  "workspaces": [
    "frontend",
    "admin",
    "packages/shared"
  ],
  "scripts": {
    "dev:admin": "npm --prefix admin run dev",
    "dev:backend": "dotnet watch --project backend/backend.csproj run",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:admin\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "supabase:setup": "node scripts/local-supabase.mjs setup",
    "supabase:up": "node scripts/local-supabase.mjs up",
    "supabase:down": "node scripts/local-supabase.mjs down",
    "supabase:seed": "node scripts/local-supabase.mjs seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "recharts": "^3.8.1",
    "@vercel/og": "^1.0.0"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "@types/node": "25.6.0"
  }
}
